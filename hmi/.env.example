# Copy to hmi/.env.local to override. All values are optional.
# The root scripts (`npm run dev` / `npm run build` at the repo root) set
# NEXT_PUBLIC_TWIN_SOURCE=http automatically unless you set it here or in the shell.

# Data source (inlined at build time — restart `npm run dev` / rebuild after changing):
#   mock — built-in simulated line, no backend needed (default when running hmi/ alone)
#   http — live twin, polled through this app's /api/twin/* proxy routes
#   ws   — skeleton WebSocket bridge at NEXT_PUBLIC_TWIN_URL
NEXT_PUBLIC_TWIN_SOURCE=mock

# http: optional base URL for the state/command endpoints (default /api/twin)
# ws:   required WebSocket URL, e.g. ws://plc-bridge.local:8080/twin
# NEXT_PUBLIC_TWIN_URL=

# Server-side (read at runtime): where the /api/twin proxy finds the twin.
# TWIN_HTTP_URL=http://127.0.0.1:43124
