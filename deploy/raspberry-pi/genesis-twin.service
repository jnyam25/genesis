# systemd unit: Genesis twin service (PLC bridge + HTTP API on 127.0.0.1:43124).
# Install: sudo cp genesis-twin.service /etc/systemd/system/ && sudo systemctl enable --now genesis-twin
[Unit]
Description=Genesis twin / PLC bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=genesis
Group=genesis
WorkingDirectory=/opt/genesis/twin
EnvironmentFile=/etc/genesis/genesis.env
# If Node was installed with nvm, replace /usr/bin/node with the absolute path from `which node`.
ExecStart=/usr/bin/node dist/run.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
