# /etc/captsone/captsone.env — environment for the Captsone services on the Raspberry Pi.
# Copy from deploy/raspberry-pi/captsone.env.example. See docs/configuration.md.

# --- Twin service (bridge) -------------------------------------------------
# "plc" = read the physical line through the PLC; "sim" = simulated line.
CAPTSONE_MODE=plc

# Micro850 PLC Modbus TCP server (use the virtual PLC's host/5020 for testing).
PLC_HOST=192.168.10.10
PLC_PORT=502
PLC_UNIT_ID=1
PLC_POLL_MS=250
# Micro850 and virtual PLC: register-map coil 0 is Modbus coil 0 (CCW address 000001).
PLC_COIL_BASE=0

# HTTP API for the HMI. Keep it on localhost; the HMI proxies to it.
CAPTSONE_HOST=127.0.0.1
CAPTSONE_PORT=43124

# Operator tank name/colour edits (HMI → Controls → Tank colors) are saved here.
# Default: <twin>/runtime/tank-colors.json. Keep it on persistent storage.
# CAPTSONE_TANK_COLORS_FILE=/var/lib/captsone/tank-colors.json

# --- HMI service -----------------------------------------------------------
# Where the HMI's /api/twin proxy finds the twin service (read at runtime).
TWIN_HTTP_URL=http://127.0.0.1:43124
NODE_ENV=production
