# Copy this file to .env.local in the repo root. .env.local is gitignored.
#
#   copy .env.example .env.local
#
# The root scripts and the twin commands read .env.local on startup.
# A variable you set in the shell wins. A commented line keeps the program default.
# An HMI started on its own (`npm run dev:hmi`) reads hmi/.env.local instead — see hmi/.env.example.
#
# NEXT_PUBLIC_* values are inlined when the HMI is built. After changing them, restart
# `npm run dev` or run `npm run build` again.

# --- Twin (npm run dev) ---
GENESIS_MODE=sim
GENESIS_HOST=127.0.0.1
GENESIS_PORT=43124
# GENESIS_TANK_COLORS_FILE=twin/runtime/tank-colors.json

# --- HMI ---
# mock = built-in line, no twin. http = live twin. ws = WebSocket at NEXT_PUBLIC_TWIN_URL.
# `npm run dev` from the root uses http unless this file or the shell says otherwise.
NEXT_PUBLIC_TWIN_SOURCE=http
# NEXT_PUBLIC_TWIN_URL=/api/twin
TWIN_HTTP_URL=http://127.0.0.1:43124

# --- Virtual PLC (npm run virtual-plc, npm run dev:plc-sim) ---
# VPLC_HOST default in the program is 0.0.0.0. 127.0.0.1 keeps it on this machine.
VPLC_HOST=127.0.0.1
VPLC_PORT=5020
VPLC_UNIT_ID=1
# VPLC_FEED=0
# VPLC_NODES=scanner,station
# VPLC_FOLLOW=1
# VPLC_PLANT=1
# VPLC_DEBUG=1
# VPLC_TRACE=1

# --- Micro850 (npm run line, npm run plc-link). Leave PLC_HOST unset for simulation. ---
# PLC_HOST=192.168.10.10
# PLC_PORT=502
# PLC_UNIT_ID=1
# PLC_POLL_MS=250
# PLC_COIL_BASE=0
# PLC_LINK_POLL_MS=250
# PLC_LINK_COMMANDS=1
# PLC_LINK_MIRROR=1

# --- FUXA (npm run fuxa). PLC_PORT here is the virtual PLC, not the Micro850. ---
FUXA_HOST=127.0.0.1
FUXA_PORT=1881
# FUXA_DATA=deploy/fuxa/data
# FUXA_URL=http://127.0.0.1:1881
# FUXA_POLL_MS=250
# FUXA_COMMANDS=1
# FUXA_PEER_HOST=127.0.0.1
# FUXA_PEER_PORT=5020
# FUXA_PEER_UNIT_ID=1

# --- Remote SCADA door (npm run scada-gateway). Both hosts are required to start it. ---
# SCADA_GATEWAY_HOST=10.44.0.1
# SCADA_GATEWAY_PORT=5502
# SCADA_GATEWAY_ALLOW_ANY=1
